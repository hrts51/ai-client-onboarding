        "sendTo": "={{ $('Merge AI Analysis').first().json.email }}",
        "subject": "=Welcome to Our Services - Onboarding Confirmation #{{ $('Merge AI Analysis').first().json.clientId }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; color: #333; }\n    .header { background-color: #2563eb; color: white; padding: 20px; border-radius: 8px 8px 0 0; }\n    .body { padding: 20px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px; }\n    .highlight { background-color: #f3f4f6; padding: 15px; border-radius: 6px; margin: 15px 0; }\n    .footer { color: #6b7280; font-size: 12px; margin-top: 20px; }\n  </style>\n</head>\n<body>\n  <div class='header'>\n    <h2>Welcome, {{ $('Merge AI Analysis').first().json.name }}!</h2>\n    <p>Your onboarding has been received.</p>\n  </div>\n  <div class='body'>\n    <p>Thank you for submitting your information. Here is a summary of what we received:</p>\n    <div class='highlight'>\n      <strong>Reference ID:</strong> {{ $('Merge AI Analysis').first().json.clientId }}<br>\n      <strong>Company:</strong> {{ $('Merge AI Analysis').first().json.company }}<br>\n      <strong>Project Type:</strong> {{ $('Merge AI Analysis').first().json.projectType }}<br>\n      <strong>Submitted:</strong> {{ $('Merge AI Analysis').first().json.submittedAt }}\n    </div>\n    <p>Our team will review your information and get back to you within <strong>1 business day</strong>.</p>\n    <p>If you have any questions, reply to this email.</p>\n    <div class='footer'>\n      <p>This is an automated message. Reference: {{ $('Merge AI Analysis').first().json.clientId }}</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
