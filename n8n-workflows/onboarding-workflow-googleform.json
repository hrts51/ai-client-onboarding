      "id": "google-form-trigger",
      "name": "Google Form Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate form data from Google Form response\nconst body = $input.first().json;\n\n// Map Google Form column names to our standard fields\nconst clientData = {\n  name: body['Full Name'] || body.name || '',\n  email: body['Email Address'] || body.email || '',\n  company: body['Company Name'] || body.company || '',\n  phone: body['Phone Number'] || body.phone || '',\n  projectType: body['Project Type'] || body.projectType || '',\n  budget: body['Budget Range'] || body.budget || '',\n  timeline: body['Expected Timeline'] || body.timeline || '',\n  description: body['Project Description'] || body.description || '',\n  submittedAt: body['Timestamp'] || new Date().toISOString()\n};\n\n// Validate required fields\nif (!clientData.email) {\n  throw new Error('Client email is required');\n}\n\nif (!clientData.name) {\n  throw new Error('Client name is required');\n}\n\nreturn { json: clientData };"
      },
      "id": "extract-data",
      "name": "Extract & Validate Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "mistral"
            },
            {
              "name": "prompt",
              "value": "=You are an AI assistant for a professional services company. A new client has submitted an onboarding form. Analyze their information and provide:\n1. A brief client profile summary (2-3 sentences)\n2. Key project requirements extracted from their description\n3. Suggested priority level (High/Medium/Low) based on budget and timeline\n4. Any important notes or concerns\n\nClient Information:\n- Name: {{ $json.name }}\n- Company: {{ $json.company }}\n- Email: {{ $json.email }}\n- Project Type: {{ $json.projectType }}\n- Budget: {{ $json.budget }}\n- Timeline: {{ $json.timeline }}\n- Description: {{ $json.description }}\n\nRespond in a structured format."
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "mistral-ai",
      "name": "Mistral AI Processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse Mistral response and combine with client data\nconst clientData = $('Extract & Validate Data').first().json;\nconst mistralResponse = $input.first().json.response || '';\n\n// Generate a unique client ID\nconst clientId = 'CLT-' + Date.now().toString(36).toUpperCase();\n\nreturn {\n  json: {\n    ...clientData,\n    clientId,\n    aiAnalysis: mistralResponse,\n    processedAt: new Date().toISOString(),\n    status: 'New'\n  }\n};"
      },
      "id": "merge-data",
      "name": "Merge AI Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
